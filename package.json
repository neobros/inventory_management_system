{
  "name": "inventory-management-system",
  "private": true,
  "version": "1.0.3",
  "description": "Inventory management and point-of-sale till",
  "author": "StockPilot",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node scripts/seed-admin.mjs",
    "electron:dev": "set ELECTRON_RUN_AS_NODE=&& set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .",
    "electron:build": "node scripts/build-installer.mjs",
    "electron:start": "vite build --mode electron && set ELECTRON_RUN_AS_NODE=&& electron .",
    "build:electron": "vite build --mode electron",
    "shop-password": "node scripts/shop-password.mjs",
    "dev:web": "vite"
  },
  "build": {
    "appId": "com.stockpilot.till",
    "productName": "StockPilot Till",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "StockPilot-Till-Setup-${version}.exe",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "StockPilot Till"
    }
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "jsbarcode": "^3.12.3",
    "qz-tray": "^2.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "firebase-admin": "^14.4.0",
    "vite": "^8.2.1"
  }
}
